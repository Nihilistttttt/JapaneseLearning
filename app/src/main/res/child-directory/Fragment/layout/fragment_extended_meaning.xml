<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <com.Nihilisttt.LearnWord.ViewPager2.NestedScrollableHostBetween3Layers
        android:id="@+id/detailed_meaning_vp2_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/guideline5"
        app:layerName="第三层 detailedMeaning"
        app:level="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@color/cardview_light_background">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/detailed_meaning_viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <com.Nihilisttt.LearnWord.ViewPager2.Vp2IndicatorView
            android:id="@+id/vp2_indicator"
            android:layout_width="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="4dp"
            android:layout_height="1dp"/>
    </com.Nihilisttt.LearnWord.ViewPager2.NestedScrollableHostBetween3Layers>

    <androidx.cardview.widget.CardView
        android:id="@+id/meaning_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline5">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/part_of_speech"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/blue"
                app:layout_constraintStart_toStartOf="@+id/original_definition"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/original_definition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/blue"
                app:layout_constraintStart_toStartOf="@+id/translation_definition"
                app:layout_constraintTop_toBottomOf="@+id/part_of_speech" />

            <TextView
                android:id="@+id/translation_definition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/blue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/original_definition" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.7" />


</androidx.constraintlayout.widget.ConstraintLayout>