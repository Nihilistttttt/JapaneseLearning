<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    android:id="@+id/small_char"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/small_margin_start"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/small_kana_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/black"
        android:textSize="@dimen/small_kana_size"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/small_kanji_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/black"
        android:textSize="@dimen/small_kanji_size"
        android:textStyle="bold" />

</LinearLayout>