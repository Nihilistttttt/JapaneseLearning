<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/learn_page_navigation"
    app:startDestination="@id/learnPageFragment">

    <fragment
        android:id="@+id/learnPageFragment"
        android:name="com.Nihilisttt.LearnWord.Fragment.LearnPage.MainLearnPage.MainLearnPageFragment"
        android:label="LearnPageFragment" >
        <action
            android:id="@+id/action_learnPageFragment_to_detailedLearnPageFragment"
            app:destination="@id/detailedLearnPageFragment" />
    </fragment>
    <fragment
        android:id="@+id/detailedLearnPageFragment"
        android:name="com.Nihilisttt.LearnWord.Fragment.LearnPage.ExtendedLearnPage.ExtendedLearnPageFragment"
        android:label="DetailedLearnPageFragment" >
        <action
            android:id="@+id/action_detailedLearnPageFragment_to_learnPageFragment"
            app:destination="@id/learnPageFragment" />
    </fragment>
</navigation>